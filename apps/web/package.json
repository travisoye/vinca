{
  "name": "vinca-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vinca frontend: a browser-based disclosure toolkit for Zcash wallet and payment developers. Presentation foundation only; protocol, vault and relay work happens in later phases per prd.md.",
  "scripts": {
    "build:wasm": "wasm-pack build ../../crates/vinca-wasm --target web --out-dir ../../apps/web/src/wasm --out-name vinca_wasm --release",
    "predev": "npm run build:wasm",
    "dev": "vite",
    "prebuild": "npm run build:wasm",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.548.0",
    "motion": "^12.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.5.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "wasm-pack": "^0.15.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "wasm-pack@0.15.0": true
  }
}
