# Vinca Public Chain Relay — Environment Configuration
#
# The relay is an unauthenticated, read-only HTTP facade in front of lightwalletd.
# It holds NO keys, processes NO private state, and permanently blocks mainnet.
#
# TCP listen port (provided automatically by Render or other container hosts):
PORT=8080

# Exact frontend origins allowed via CORS (comma-separated if multiple, no wildcards):
WEB_ORIGIN=https://vincaonzec.vercel.app

# Upstream testnet lightwalletd gRPC endpoint:
LIGHTWALLETD_TESTNET_URL=https://testnet.zec.rocks:443

# Optional: Regtest upstream for reproducible local testing:
# LIGHTWALLETD_REGTEST_URL=http://localhost:9067
